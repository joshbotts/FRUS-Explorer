sqlite3 -readonly $DB "SELECT 'ALL quarantin', COUNT(*), COUNT(DISTINCT d.volume_id) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE f.frus_documents MATCH 'quarantin' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') UNION ALL SELECT 'quarantin + health words', COUNT(*), COUNT(DISTINCT d.volume_id) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE f.frus_documents MATCH 'quarantin AND (cholera OR plagu OR sanitari OR fever OR diseas OR epidem OR disinfect OR health OR hygien OR pratiqu)' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') UNION ALL SELECT 'quarantin, NO health words', COUNT(*), COUNT(DISTINCT d.volume_id) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE f.frus_documents MATCH 'quarantin NOT (cholera OR plagu OR sanitari OR fever OR diseas OR epidem OR disinfect OR health OR hygien OR pratiqu)' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2');"
sqlite3 -readonly $DB "SELECT substr(dd.date_iso,1,3)||'0s' dec, COUNT(*) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid JOIN document_dates dd ON dd.volume_id=d.volume_id AND dd.document_id=d.document_id WHERE f.frus_documents MATCH 'quarantin' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND dd.date_iso IS NOT NULL AND dd.date_iso<>'' AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') GROUP BY dec ORDER BY dec;"

