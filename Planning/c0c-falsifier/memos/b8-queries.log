### 19. PRE-1910 NUMERICAL FILE RESOLUTION (JSON + DB) -- scripts numfile.py, numfile2.py
# SQL in both: SELECT raw_text FROM document_sources WHERE volume_id=? AND document_id=?
#              SELECT date_iso FROM document_dates WHERE volume_id=? AND document_id=?
python3 -u numfile.py       # FIRST, WRONG: regex 'File\s*No\.?\s*(\d+)' read the 1911 decimal class 158.931 as case 158
python3 -u numfile2.py      # form gate (?!\.\d) + date gate (<1910-08-01); first form-gate regex was (?![\d]*\.) which wrongly dropped "File No. 20272."
sed -i.bak "s|NUM=re.compile(...)|NUM=re.compile(r'File\\s*No\\.?\\s*(\\d+)(?!\\.\\d)')|" numfile2.py
python3 -u numfile2.py      # FINAL: 9 of 22 resolved, 2 rolls, both with a scan row

