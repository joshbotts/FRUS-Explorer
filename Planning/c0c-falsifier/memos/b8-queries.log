### 12. LITERAL-SHARE PASS, STRICT + TOLERANT (DB) -- script litshare.py -> litshare-out.json
# litshare.py SQL (once per family): SELECT d.volume_id,d.document_id,
#   COALESCE(d.header,'')||' '||COALESCE(d.dateline,'')||' '||COALESCE(d.source_note,'')||' '||COALESCE(d.body_text,'')
#   FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid
#   WHERE f.frus_documents MATCH '"<phrase>"' AND d.is_front_matter=0 AND d.is_editorial_note=0
#     AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') ORDER BY d.volume_id, d.document_id
# Regex: STRICT = \b<words joined by single spaces>\b ; TOLERANT = inflected words joined by [ \-,\(\)\.]+ ; both re.I (case-INSENSITIVE Python re)
python3 -u litshare.py                              # all 8 families CENSUSED (M<=300)

