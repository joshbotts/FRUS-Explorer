python3 -u - <<'EOF' :: import sqlite3, json, re, pickle\ncon=sqlite3.connect('file:/Users/jbotts/frus-analysis/frus-copy.db?mode=ro',uri=True)\nrows=con.execute("SELECT volume_id, structure_json FROM volume_structures").fetchall()\ninc=re.compile(r'canal|isthm|^panama|panama[,:]|panama\b', re.I)\nexc=re.compile(r'suez|kiel|grand canal|lynn canal|canal de haro|baltic|massena|great lakes|huai|anglo-egyptian|aswan|egypt|guatemala|canal zone;? the threat|assault on the canal zone|panama-pacific', re.I)\ncore=set(); vols={}\ndef walk(n,v,inh=False):\n    t=(n.get('title') or '')\n    hit = inh or (bool(inc.search(t)) and not exc.search(t))\n    if hit:\n        for i in (n.get('documentIds') or []): core.add((v,i)); vols[v]=vols.get(v,0)+1\n    for s in (n.get('subsections') or []): walk(s,v,hit)\nfor v,sj in rows:\n    d=json.loads(sj)\n    for s in (d.get('sections') or []): walk(s,v)\nprint("EDITORIAL CORE:", len(core), "docs in", len(vols), "volumes")\nfor v,n in sorted(vols.items(), key=lambda x:-x[1])[:30]: print(f"  {v}\t{n}")\nq="canal AND (isthmus OR isthmian OR Panama OR Nicaragua OR interoceanic OR \"inter-oceanic\")"\nfts=set(con.execute("SELECT volume_id, document_id FROM frus_documents WHERE frus_documents MATCH ?",(q,)).fetchall())\nprint("core-fts",len(core&fts),"core-only",len(core-fts),"fts-only",len(fts-core),"union",len(core|fts))\npickle.dump({'core2':core},open('sets2.pkl','wb'))
python3 -u - <<'EOF' :: import sqlite3, json, re\ncon=sqlite3.connect('file:/Users/jbotts/frus-analysis/frus-copy.db?mode=ro',uri=True)\nfor v in ('frus1940v01','frus1917Supp01v01','frus1946v11'):\n    sj=con.execute("SELECT structure_json FROM volume_structures WHERE volume_id=?",(v,)).fetchone()[0]\n    d=json.loads(sj); found=[]\n    def walk(n):\n        t=(n.get('title') or '')\n        if re.search(r'panama|isthm|canal',t,re.I): found.append((len(n.get('documentIds') or []),' '.join(t.split())[:110]))\n        for s in (n.get('subsections') or []): walk(s)\n    for s in d.get('sections') or []: walk(s)\n    print(v); [print('   ',n,t) for n,t in found]\nq="canal AND (isthmus OR isthmian OR Panama OR Nicaragua OR interoceanic OR \"inter-oceanic\")"\nprint("FTS volumes:",con.execute("SELECT COUNT(DISTINCT volume_id) FROM frus_documents WHERE frus_documents MATCH ?",(q,)).fetchone()[0])
python3 -u - <<'EOF' :: import sqlite3\ncon=sqlite3.connect('file:/Users/jbotts/frus-analysis/frus-copy.db?mode=ro',uri=True)\nQ={'NEG1':'canal AND (isthmus OR isthmian OR Panama OR Nicaragua OR interoceanic) AND (treaty OR convention OR negotiation OR negotiate OR ratification OR protocol OR concession)','NEG2':'(canal OR isthmus) AND ("right of way" OR "rights of way" OR "exclusive right" OR concession OR grant) AND (Panama OR Nicaragua OR Colombia OR Costa OR Isthmus)','SOV':'canal AND (sovereignty OR "sovereign rights" OR jurisdiction) AND (Panama OR "Canal Zone")','FORT':'canal AND (fortif* OR neutralit* OR defense OR defence) AND (Panama OR isthmus OR Nicaragua)','ROUTE':'canal AND (route OR survey OR "sea level" OR lock*) AND (Nicaragua OR Panama OR Atrato OR Tehuantepec OR Darien)'}\nfor k,q in Q.items():\n    n=con.execute("SELECT COUNT(*) FROM frus_documents WHERE frus_documents MATCH ?",(q,)).fetchone()[0]\n    nv=con.execute("SELECT COUNT(DISTINCT volume_id) FROM frus_documents WHERE frus_documents MATCH ?",(q,)).fetchone()[0]\n    print(f"{k:6s} {n:5d} docs  {nv:3d} volumes")\nfor a,b in con.execute("SELECT substr(COALESCE(dd.date_iso,'na'),1,3)||'0', COUNT(*) FROM frus_documents f LEFT JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH ? GROUP BY 1 ORDER BY 1",(Q['NEG1'],)): print('  ',a,b)
