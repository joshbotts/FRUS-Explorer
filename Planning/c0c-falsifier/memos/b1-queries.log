python3 -u - <<'EOF' :: import sqlite3, json, re, pickle\ncon=sqlite3.connect('file:/Users/jbotts/frus-analysis/frus-copy.db?mode=ro',uri=True)\nrows=con.execute("SELECT volume_id, structure_json FROM volume_structures").fetchall()\ninc=re.compile(r'canal|isthm', re.I)\nexc=re.compile(r'suez|kiel|grand canal|lynn canal|canal de haro|baltic|massena|great lakes|huai|anglo-egyptian|aswan|egypt|guatemala', re.I)\ncore=set(); vols={}\ndef walk(n,v,inherited=False):\n    t=(n.get('title') or '')\n    hit = inherited or (bool(inc.search(t)) and not exc.search(t))\n    if hit:\n        for i in (n.get('documentIds') or []):\n            core.add((v,i)); vols[v]=vols.get(v,0)+1\n    for s in (n.get('subsections') or []): walk(s,v,hit)\nfor v,sj in rows:\n    d=json.loads(sj)\n    for s in (d.get('sections') or []): walk(s,v)\nprint("STRUCTURAL CORE:", len(core), "docs in", len(vols), "volumes")\nfor v,n in sorted(vols.items(), key=lambda x:-x[1])[:22]: print(f"  {v}\t{n}")\nq="canal AND (isthmus OR isthmian OR Panama OR Nicaragua OR interoceanic OR \"inter-oceanic\")"\nfts=set(con.execute("SELECT volume_id, document_id FROM frus_documents WHERE frus_documents MATCH ?",(q,)).fetchall())\nprint("FTS set:",len(fts)," core-fts:",len(core&fts)," core-only:",len(core-fts)," fts-only:",len(fts-core))\npickle.dump({'core':core,'fts':fts},open('sets.pkl','wb'))
