sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH fam AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"sanitary convention\" OR \"sanitary conference\" OR \"international sanitary\" OR \"sanitary code\" OR \"sanitary bureau\" OR \"sanitary regulations\" OR \"quarantine regulations\" OR \"quarantine station\" OR \"quarantine board\" OR lazaretto OR pratique OR \"bill of health\" OR \"international office of public health\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT 'FAMILY_docs', COUNT(*), COUNT(DISTINCT v) FROM fam;"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH fam AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"sanitary convention\" OR \"sanitary conference\" OR \"international sanitary\" OR \"sanitary code\" OR \"sanitary bureau\" OR \"sanitary regulations\" OR \"quarantine regulations\" OR \"quarantine station\" OR \"quarantine board\" OR lazaretto OR pratique OR \"bill of health\" OR \"international office of public health\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT 'CAME_FROM era '||s.citation_era, COUNT(*) FROM fam JOIN document_sources s ON s.volume_id=fam.v AND s.document_id=fam.id GROUP BY 1 ORDER BY 2 DESC;"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH fam AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"sanitary convention\" OR \"sanitary conference\" OR \"international sanitary\" OR \"sanitary code\" OR \"sanitary bureau\" OR \"sanitary regulations\" OR \"quarantine regulations\" OR \"quarantine station\" OR \"quarantine board\" OR lazaretto OR pratique OR \"bill of health\" OR \"international office of public health\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT 'POINTED_AT rows', COUNT(*), COUNT(DISTINCT e.volume_id||'/'||e.document_id) FROM fam JOIN external_citations e ON e.volume_id=fam.v AND e.document_id=fam.id;"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH fam AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"sanitary convention\" OR \"sanitary conference\" OR \"international sanitary\" OR \"sanitary code\" OR \"sanitary bureau\" OR \"sanitary regulations\" OR \"quarantine regulations\" OR \"quarantine station\" OR \"quarantine board\" OR lazaretto OR pratique OR \"bill of health\" OR \"international office of public health\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT 'POINTED_AT '||IFNULL(e.repository,'-')||' | '||IFNULL(e.collection,'-')||' | lot '||IFNULL(e.lot_file,'-')||' | class '||IFNULL(e.decimal_class,'-'), COUNT(*) FROM fam JOIN external_citations e ON e.volume_id=fam.v AND e.document_id=fam.id GROUP BY 1 ORDER BY 2 DESC LIMIT 20;"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH fam AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"sanitary convention\" OR \"sanitary conference\" OR \"international sanitary\" OR \"sanitary code\" OR \"sanitary bureau\" OR \"sanitary regulations\" OR \"quarantine regulations\" OR \"quarantine station\" OR \"quarantine board\" OR lazaretto OR pratique OR \"bill of health\" OR \"international office of public health\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT CASE WHEN dt.date_iso<'1910-01-01' THEN 'pre-1910' WHEN dt.date_iso IS NULL THEN 'undated' ELSE '1910+' END era, COUNT(*) docs, SUM(CASE WHEN s.volume_id IS NOT NULL THEN 1 ELSE 0 END) with_source_row FROM fam LEFT JOIN document_dates dt ON dt.volume_id=fam.v AND dt.document_id=fam.id LEFT JOIN document_sources s ON s.volume_id=fam.v AND s.document_id=fam.id GROUP BY 1 ORDER BY 2 DESC;"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH fam AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"sanitary convention\" OR \"sanitary conference\" OR \"international sanitary\" OR \"sanitary code\" OR \"sanitary bureau\" OR \"sanitary regulations\" OR \"quarantine regulations\" OR \"quarantine station\" OR \"quarantine board\" OR lazaretto OR pratique OR \"bill of health\" OR \"international office of public health\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')), den AS (SELECT substr(dt.date_iso,1,3)||'0s' dec, COUNT(*) n FROM document_cache d JOIN document_dates dt ON dt.volume_id=d.volume_id AND dt.document_id=d.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') AND dt.date_iso IS NOT NULL GROUP BY 1) SELECT substr(dt.date_iso,1,3)||'0s' dec, COUNT(*) hits, den.n AS dated_nonapparatus, ROUND(1000.0*COUNT(*)/den.n,3) AS per_1000, (SELECT f2.v||':'||COUNT(*) FROM fam f2 JOIN document_dates d2 ON d2.volume_id=f2.v AND d2.document_id=f2.id WHERE substr(d2.date_iso,1,3)=substr(dt.date_iso,1,3) GROUP BY f2.v ORDER BY COUNT(*) DESC LIMIT 1) AS top_volume FROM fam JOIN document_dates dt ON dt.volume_id=fam.v AND dt.document_id=fam.id JOIN den ON den.dec=substr(dt.date_iso,1,3)||'0s' WHERE dt.date_iso IS NOT NULL GROUP BY 1 ORDER BY 1;"

