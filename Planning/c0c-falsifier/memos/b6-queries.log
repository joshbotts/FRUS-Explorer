python3 -u referent.py | tee referent_out.txt
# (b) the SQL version actually reported in the memo (document-level co-occurrence), three statements:
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH q AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'quarantine' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT 'quarantine_total', COUNT(*) FROM q;"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH q AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'quarantine' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')), dis AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'cholera OR \"yellow fever\" OR smallpox OR typhus OR epidemic OR sanitary OR pratique OR lazaretto OR \"bill of health\" OR disinfection OR fumigation OR pestilence OR bubonic' AND d.is_front_matter=0 AND d.is_editorial_note=0) SELECT 'quarantine_WITH_disease_vocab', COUNT(*) FROM q WHERE EXISTS (SELECT 1 FROM dis WHERE dis.v=q.v AND dis.id=q.id);"
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH q AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'quarantine' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')), dis AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'cholera OR \"yellow fever\" OR smallpox OR typhus OR epidemic OR sanitary OR pratique OR lazaretto OR \"bill of health\" OR disinfection OR fumigation OR pestilence OR bubonic' AND d.is_front_matter=0 AND d.is_editorial_note=0) SELECT substr(dt.date_iso,1,3)||'0s', SUM(CASE WHEN EXISTS(SELECT 1 FROM dis WHERE dis.v=q.v AND dis.id=q.id) THEN 1 ELSE 0 END) AS with_disease, COUNT(*) AS all_quarantine FROM q JOIN document_dates dt ON dt.volume_id=q.v AND dt.document_id=q.id WHERE dt.date_iso IS NOT NULL GROUP BY 1 ORDER BY 1;"

# ---------- 13. REFERENT test for 'sanitary' (the pork/cattle false friend) ----------
sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH san AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'sanitary' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')), ani AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'pork OR swine OR trichina OR trichinosis OR \"hog cholera\" OR cattle OR \"foot and mouth\" OR \"salted meats\" OR bacon OR hogs OR livestock OR \"live stock\"' AND d.is_front_matter=0 AND d.is_editorial_note=0), hum AS (SELECT f.volume_id v, f.document_id id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'cholera OR \"yellow fever\" OR smallpox OR typhus OR quarantine OR \"bill of health\" OR pratique OR lazaretto OR \"public health\" OR \"board of health\" OR plague' AND d.is_front_matter=0 AND d.is_editorial_note=0) SELECT substr(dt.date_iso,1,3)||'0s' dec, COUNT(*) sanitary_docs, SUM(CASE WHEN EXISTS(SELECT 1 FROM ani WHERE ani.v=san.v AND ani.id=san.id) THEN 1 ELSE 0 END) with_animal_meat_vocab, SUM(CASE WHEN EXISTS(SELECT 1 FROM hum WHERE hum.v=san.v AND hum.id=san.id) THEN 1 ELSE 0 END) with_human_disease_vocab FROM san JOIN document_dates dt ON dt.volume_id=san.v AND dt.document_id=san.id WHERE dt.date_iso IS NOT NULL GROUP BY 1 ORDER BY 1;"

