# ---------- 11. LITERAL-SHARE CENSUS (script share.py -> share_out.txt) ----------
# python3, re module, re.IGNORECASE, whole hit set (census) for each family; surface =
#   header||' '||dateline||' '||source_note||' '||body_text, whitespace-collapsed.
# The SQL share.py runs, once per family, is exactly:
#   SELECT d.volume_id, d.document_id, d.header||' '||IFNULL(d.dateline,'')||' '||IFNULL(d.source_note,'')||' '||d.body_text
#   FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id
#   WHERE frus_documents MATCH ? AND d.is_front_matter=0 AND d.is_editorial_note=0
#     AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') ORDER BY d.volume_id, d.document_id
python3 -u share.py "international sanitary convention" "sanitary convention" "sanitary conference" "bill of health" "quarantine regulations" "pan american sanitary" "quarantine station" "sanitary bureau" | tee share_out.txt

# ---------- 12. REFERENT test for 'quarantine' ----------
# (a) proximity classifier, script referent.py -> referent_out.txt + quarantine_classified.tsv.
#     Its SQL:  ... WHERE frus_documents MATCH 'quarantine' AND d.is_front_matter=0 AND d.is_editorial_note=0
