# --- 4. the editors' own chapter headings ---
[DB] sqlite3 -readonly frus-copy.db "SELECT volume_id, structure_json FROM volume_structures LIMIT 1;"
[DB] python3 -u headings.py    # walks volume_structures.structure_json for every volume; regex r'canal|isthm|interocean|panama|nicaragua|tehuantepec|clayton|pauncefote|darien|darién' (re.I) over section titles.  OUTPUT: headings_canal.tsv (622 headings, 129 volumes)
     awk -F'\t' 'NR>1 && ($3 ~ /[Cc]anal|[Ii]sthm|[Ii]nterocean|[Tt]ehuantepec|[Cc]layton|[Pp]auncefote/)' headings_canal.tsv | sort -t$'\t' -k4,4nr | head -60
     awk -F'\t' 'NR>1 && $1 ~ /^frus1(8|90|91)/ && ($3 ~ /[Cc]anal|[Ii]sthm|[Ii]nterocean|[Tt]ehuantepec|[Cc]layton|[Dd]arien/)' headings_canal.tsv | cut -f1,3,4

# --- 5. phrase family: raw counts (backgrounded shell loop) ---
[DB] for P in "isthmian canal" "interoceanic canal" "ship canal" "canal zone" "panama canal" "nicaragua canal" "nicaraguan canal" "isthmus of panama" "clayton bulwer" "hay pauncefote" "bunau varilla" "canal treaty" "canal tolls" "panama railroad" "canal commission" "maritime canal" "canal route" "suez canal"; do
       sqlite3 -readonly frus-copy.db "SELECT COUNT(*) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE f.frus_documents MATCH '\"$P\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2');"
       sqlite3 -readonly frus-copy.db "SELECT COUNT(DISTINCT d.volume_id) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE f.frus_documents MATCH '\"$P\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2');"
     done

# --- 6. literal-share verification (STRICT + TOLERANT), pass 1 ---
[DB] python3 -u share.py
     # SELECT run per phrase, verbatim:
     #   SELECT d.volume_id, d.document_id, d.header, d.dateline, d.source_note, d.body_text
     #   FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid
     #   WHERE f.frus_documents MATCH ? AND d.is_front_matter=0 AND d.is_editorial_note=0
     #     AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')
     #   ORDER BY d.volume_id, d.document_id
     # regex applied to header+dateline+source_note+body_text joined by ' ' and whitespace-collapsed; Python re, re.I (case-INSENSITIVE, matching SQLite LIKE) for the whole family.
     # STRICT  = r'\b' + ' '.join(escaped words) + r'\b'
     # TOLERANT(pass 1) = words joined by r'[ \-,\(\)\.]+', each word + r'(?:s|es|ian|ians|ic|al|an|ans)?'
     # census when M<=300, else 40 evenly spaced indices int(i*M/40).  OUTPUT: share_family1.json

# --- 7. literal-share pass 2: dash-tolerant separators + y->ies inflection + referent split ---
[DB] python3 -u share2.py
     # TOLERANT(pass 2) separator class = r'[ \-‐‑‒–—,\(\)\.]+' (adds U+2010 U+2011 U+2012 U+2013 U+2014)
     # each word -> r'(?:WORD(?:s|es|ies|ian|ians|ic|al|an|ans)?|WORDSTEMies)'
     # referent split per document: SUEZ = r'\bsuez\b'; ISTHMIAN = r'\bpanama|isthm|nicaragua'
     # OUTPUT: share_family2.json

# --- 8. building the core set ---
[DB] python3 -u core.py    # FTS MATCH is the OR of all 17 quoted phrases; SELECT as in step 6 but WITHOUT the Ed2 exclusion in SQL (applied in Python).
     # first run had a circular Tier-B filter (the isthmian-word regex contained 'canal zone'); corrected with:
     sed -i.bak "s|ISTH=re.compile(r'\\b(panama|...|canal zone)',re.I)|ISTH=re.compile(r'\\b(panama|panamanian|panaman|isthmus|isthmian|nicaragua|nicaraguan|darien|dari[eé]n|tehuantepec)',re.I)|" core.py
[DB] python3 -u core.py    # re-run after the fix.  OUTPUTS: core_set.tsv, rejected_generic.tsv, literal_share_failures.tsv
     # BOTH SIDES OF THE FIX, same script, decisive line:  Tier B 890 docs / 172 vols (circular) -> 531 / 105 (fixed); rejected 129 -> 488; core 3,256 -> 2,897.

