[DB] sqlite3 -readonly frus-copy.db "SELECT term, doc, cnt FROM frus_documents_vocab WHERE term IN ('canal','canals','isthmian','isthmus','interoceanic','interocean','panama','nicaragua','tehuantepec','darien','clayton','bulwer','pauncefote','herran','varilla','torrijos') ORDER BY cnt DESC;"
[DB] sqlite3 -readonly frus-copy.db "SELECT term, doc, cnt FROM frus_documents_vocab WHERE term LIKE 'isthm%' OR term LIKE 'pauncef%' OR term LIKE 'torrijo%' OR term LIKE 'interocean%' OR term LIKE 'bunau%' OR term LIKE 'zonian%' OR term LIKE 'lock%' OR term LIKE 'transisthm%' OR term LIKE 'wyse%' OR term LIKE 'lesseps%' OR term LIKE 'chagres%' OR term LIKE 'culebra%' ORDER BY cnt DESC LIMIT 40;"
