[SQL] sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH core AS ( SELECT f.volume_id vid, f.document_id did FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"isthmian canal\" OR \"interoceanic canal\" OR \"inter oceanic canal\" OR \"Panama Canal\" OR \"Nicaragua Canal\" OR \"Nicaraguan Canal\" OR \"Clayton Bulwer\" OR \"Hay Pauncefote\" OR \"Hay Herran\" OR \"Bunau Varilla\" OR \"Isthmus of Panama\" OR \"Isthmus of Darien\" OR \"Isthmus of Tehuantepec\" OR \"canal treaty\" OR \"canal zone\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND f.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') ), den AS ( SELECT substr(dd.date_iso,1,3)||'0' dec, COUNT(*) n FROM document_dates dd JOIN document_cache d ON d.volume_id=dd.volume_id AND d.document_id=dd.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND dd.date_iso IS NOT NULL AND dd.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') GROUP BY 1 ), num AS ( SELECT substr(dd.date_iso,1,3)||'0' dec, COUNT(*) n FROM core c JOIN document_dates dd ON dd.volume_id=c.vid AND dd.document_id=c.did WHERE dd.date_iso IS NOT NULL GROUP BY 1 ) SELECT den.dec, COALESCE(num.n,0) canal_docs, den.n dated_docs, ROUND(1000.0*COALESCE(num.n,0)/den.n,2) per_1000 FROM den LEFT JOIN num ON num.dec=den.dec ORDER BY den.dec;"
