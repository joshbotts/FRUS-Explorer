# ---------- 10. literal-share checks (share.py, kept on disk; results in share_results.json) ----------
# share.py hit list per phrase:
#   SELECT f.volume_id, f.document_id FROM frus_documents f
#   JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id
#   WHERE frus_documents MATCH ? AND d.is_front_matter=0 AND d.is_editorial_note=0
#     AND f.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')
#   ORDER BY f.volume_id, f.document_id            -- ? bound to '"<phrase>"'
# then per selected doc:
#   SELECT header,dateline,source_note,body_text FROM document_cache WHERE volume_id=? AND document_id=?
# regex surface: those four columns joined by ' ', then re.sub(r'\s+',' ',...). Python re, re.I (case-INSENSITIVE).
#   STRICT   = r'\b' + ' '.join(escape(w)) + r'\b'
#   TOLERANT = r'\b' + SEP.join(escape(w)+SUF) + r'\b'  with SUF=(?:s|es|ed|ing|'s|’s)?  SEP=[ \-,().‐-―]+
[SQL] python3 -u share.py "isthmian canal" "interoceanic canal" "ship canal" "Clayton Bulwer" "Hay Pauncefote" "Hay Herran" "Bunau Varilla" "Nicaragua Canal" "Nicaraguan Canal" "Isthmus of Panama"
[SQL] python3 -u share.py "canal treaty" "Panama Canal" "canal zone" "Panama Canal Company" "canal tolls"
[SQL] python3 -u -c "... SELECT header,dateline,source_note,body_text FROM document_cache WHERE volume_id=? AND document_id=? ... for frus1913/d231, frus1940v05/d1194, frus1939v05/d668, frus1951v02/d749 ... regex [Ii]sthmus\W{1,4}\w{0,3}\W{0,3}Panam\w* and [Ii]nter\W{0,3}ocean\w*\W{1,4}canal\w*"
[SQL] python3 -u -c "... SELECT COUNT(*) FROM document_cache WHERE (header||' '||COALESCE(body_text,'')) LIKE ? ... for '%Hay-Herran%','%Hay-Herrán%','%Herrán%','%Herran%'"
[SQL] python3 -u -c "... regex [Cc]anal\W{1,3}[Tt]reat\w* over frus1964-68v31/d390, frus1977-80v03/d306, frus1977-80v29/d270, frus1977-80v24/d237; regex [Cc]anal\W{1,6}[Tt]oll\w*|[Tt]oll\w*\W{1,6}[Cc]anal over frus1892/d231, frus1927v01/d391, frus1955-57v16/d301, frus1958-60v07p1/d309"
[SQL] python3 -u -c "... same hit list for '\"canal treaty\"', TOLERANT2 = r'\bcanals?[ \-,().]+treat(?:y|ies|ys)\b', re.I, 40-doc evenly spaced sample"

