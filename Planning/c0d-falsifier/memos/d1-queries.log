# --- 9. literal STRICT/TOLERANT share verification (house rule (a)/(b)) ---
# $D/fams.json = ["postal convention","Universal Postal Union","postal union","parcel post",
#                 "Postmaster General","postal administration","international postal",
#                 "postal treaty","postal congress","Post Office Department"]
# $D/share.py runs, per family:
#   SELECT f.volume_id, f.document_id FROM frus_documents f
#     JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id
#     WHERE frus_documents MATCH ? AND d.is_front_matter=0 AND d.is_editorial_note=0
#     ORDER BY f.volume_id, f.document_id
#   then, per hit:
#   SELECT header||' '||COALESCE(dateline,'')||' '||COALESCE(source_note,'')||' '||body_text
#     FROM document_cache WHERE volume_id=? AND document_id=?
#   whitespace-collapsed; STRICT = re.escape(phrase), re.I; TOLERANT = inflected words joined by
#   r'[\s\-,\(\)\.]+', re.I.  Every family had M<=300 so the whole hit list was censused.
#   Python re with re.I throughout (NOT SQL LIKE) — stated in the memo.
python3 -u $D/share.py $D/fams.json | tee $D/shares.txt

# --- 10. CORE family: size, 19th-century listing ---
