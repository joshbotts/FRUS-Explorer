sqlite3 -readonly frus-copy.db "SELECT COUNT(DISTINCT f.volume_id) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '$Q' AND d.is_front_matter=0 AND d.is_editorial_note=0;"
