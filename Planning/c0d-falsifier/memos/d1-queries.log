# --- 21. archival apparatus coverage of the CORE set, by era ---
sqlite3 -readonly frus-copy.db "
WITH t AS (SELECT f.volume_id v,f.document_id q, dd.date_iso dt FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id LEFT JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH '$CORE' AND d.is_front_matter=0 AND d.is_editorial_note=0)
