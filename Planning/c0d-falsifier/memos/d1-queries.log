sqlite3 -readonly -separator '  |  ' frus-copy.db "SELECT f.volume_id||'/'||f.document_id, COALESCE(dd.date_iso,'?'), substr(replace(d.header,char(10),' '),1,95) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id LEFT JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH '$CORE' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND f.volume_id < 'frus1900' ORDER BY f.volume_id, f.document_id;"

