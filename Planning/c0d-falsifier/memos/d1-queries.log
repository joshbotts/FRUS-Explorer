sqlite3 -readonly frus-copy.db "SELECT COUNT(*), COUNT(DISTINCT s.volume_id) FROM document_sources s JOIN document_cache d ON d.volume_id=s.volume_id AND d.document_id=s.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND s.decimal_class GLOB '8[0-9][0-9].71*';"
sqlite3 -readonly frus-copy.db "SELECT s.decimal_class, COUNT(*) c FROM document_sources s JOIN document_cache d ON d.volume_id=s.volume_id AND d.document_id=s.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND s.decimal_class GLOB '5*' AND (d.body_text LIKE '%postal%' OR d.body_text LIKE '%Postal%') GROUP BY s.decimal_class ORDER BY c DESC LIMIT 15;"
