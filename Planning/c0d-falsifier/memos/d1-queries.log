# --- 3. CONTROLS + first term census (loop over $q; predicate shown once, ran once per term) ---
for q in '"Department of State"' '"ZZZ_IMPOSSIBLE_ZZZ"' '"postal convention"' '"Universal Postal Union"' '"postal union"' '"Postmaster General"' '"parcel post"' '"postal congress"'; do
  sqlite3 -readonly frus-copy.db "SELECT COUNT(*) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '$q' AND d.is_front_matter=0 AND d.is_editorial_note=0;"
done

# --- 4. wider vocabulary census, same predicate, 25 terms ---
