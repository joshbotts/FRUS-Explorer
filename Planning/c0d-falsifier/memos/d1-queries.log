sqlite3 -readonly frus-copy.db "SELECT COUNT(*) FROM (SELECT f.volume_id v,f.document_id dq FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '$CORE' AND d.is_front_matter=0 AND d.is_editorial_note=0 INTERSECT SELECT f.volume_id,f.document_id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '$MAIL' AND d.is_front_matter=0 AND d.is_editorial_note=0);"
sqlite3 -readonly -separator '  |  ' frus-copy.db "SELECT f.volume_id||'/'||f.document_id, dd.date_iso, substr(replace(d.header,char(10),' '),1,80) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH '$CORE' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND dd.date_iso>='1946' ORDER BY dd.date_iso;"

