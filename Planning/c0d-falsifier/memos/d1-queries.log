# --- 6. decade denominators and numerators (periodised on document_dates.date_iso; Ed2 dupes suppressed) ---
sqlite3 -readonly frus-copy.db "SELECT substr(dd.date_iso,1,3)||'0s' dec, COUNT(*) FROM document_dates dd JOIN document_cache d ON d.volume_id=dd.volume_id AND d.document_id=dd.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND dd.date_iso IS NOT NULL AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') GROUP BY dec ORDER BY dec;"
sqlite3 -readonly frus-copy.db "SELECT substr(dd.date_iso,1,3)||'0s' dec, COUNT(*) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH '$Q' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND dd.date_iso IS NOT NULL AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') GROUP BY dec ORDER BY dec;"

# --- 7. top-volume share per decade ---
sqlite3 -readonly frus-copy.db "
WITH hits AS (
 SELECT f.volume_id v, substr(dd.date_iso,1,3)||'0s' dec
 FROM frus_documents f
 JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id
 JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id
 WHERE frus_documents MATCH '$Q' AND d.is_front_matter=0 AND d.is_editorial_note=0
   AND dd.date_iso IS NOT NULL AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')
), per AS (SELECT dec, v, COUNT(*) c FROM hits GROUP BY dec, v),
tot AS (SELECT dec, COUNT(*) n FROM hits GROUP BY dec)
SELECT tot.dec, tot.n, per.v, per.c FROM tot JOIN per ON per.dec=tot.dec
WHERE per.c = (SELECT MAX(c) FROM per p2 WHERE p2.dec=tot.dec) ORDER BY tot.dec;"

