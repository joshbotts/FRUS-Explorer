# --- 23. citation graph and family summary table ---
sqlite3 -readonly frus-copy.db "
WITH t AS (SELECT f.volume_id v,f.document_id q FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '$CORE' AND d.is_front_matter=0 AND d.is_editorial_note=0)
SELECT COUNT(*) FROM cross_references c JOIN t s ON s.v=c.source_volume_id AND s.q=c.source_document_id JOIN t g ON g.v=c.target_volume_id AND g.q=c.target_document_id WHERE c.is_broken=0;"
sqlite3 -readonly frus-copy.db "
WITH t AS (SELECT f.volume_id v,f.document_id q FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '$CORE' AND d.is_front_matter=0 AND d.is_editorial_note=0)
SELECT COUNT(*) FROM cross_references c JOIN t s ON s.v=c.source_volume_id AND s.q=c.source_document_id WHERE c.is_broken=0;"
for p in "postal convention" "postal conventions" "Universal Postal Union" "General Postal Union" "postal union" "postal congress" "postal treaty" "postal arrangement" "postal agreement" "international postal" "postal administration" "parcel post" "postal money order" "money order" "postal service" "Post Office Department" "Postmaster General"; do
 sqlite3 -readonly -separator '  ' frus-copy.db "SELECT COUNT(*)||' docs', COUNT(DISTINCT f.volume_id)||' vols', COALESCE(MIN(dd.date_iso),'-')||' .. '||COALESCE(MAX(dd.date_iso),'-') FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id LEFT JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH '\"$p\"' AND d.is_front_matter=0 AND d.is_editorial_note=0;"
done

# --- 24. the 1951 UPU run and the 1932-34 Manchukuo episode ---
sqlite3 -readonly -separator '  |  ' frus-copy.db "SELECT document_id, substr(replace(header,char(10),' '),1,88) FROM document_cache WHERE volume_id='frus1951v02' AND document_id IN ('d138','d139','d141','d145','d150','d153','d156','d179','d181') ORDER BY CAST(substr(document_id,2) AS INTEGER);"
sqlite3 -readonly frus-copy.db "SELECT body_text FROM document_cache WHERE volume_id='frus1951v02' AND document_id='d139';" > $D/reads/frus1951v02.d139.body.txt
sqlite3 -readonly frus-copy.db "SELECT length(body_text) FROM document_cache WHERE volume_id='frus1951v02' AND document_id='d139';"
head -c 1500 $D/reads/frus1951v02.d139.body.txt
sqlite3 -readonly -separator '  |  ' frus-copy.db "SELECT document_id, substr(replace(header,char(10),' '),1,86) FROM document_cache d WHERE volume_id='frus1934v03' AND is_front_matter=0 AND is_editorial_note=0 AND (body_text LIKE '%postal convention%' OR body_text LIKE '%postal union%' OR body_text LIKE '%parcel post%' OR body_text LIKE '%postal agreement%') ORDER BY CAST(substr(document_id,2) AS INTEGER) LIMIT 16;"
for p in "closed mail" "closed mails" "mail convention" "exchange of correspondence" "letter postage" "ocean postage" "international postage" "postal service" "mail packet" "packet service" "postal bureau" "Bern" "Berne" "Manchukuo" "postal separation" "franking privilege" "postal card convention"; do
 sqlite3 -readonly frus-copy.db "SELECT COUNT(*) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"$p\"' AND d.is_front_matter=0 AND d.is_editorial_note=0;"
done
sqlite3 -readonly -separator '  |  ' frus-copy.db "SELECT volume_id||'/'||document_id, substr(replace(header,char(10),' '),1,70) FROM document_cache WHERE is_front_matter=0 AND is_editorial_note=0 AND body_text LIKE '%Manchukuo%' AND (body_text LIKE '%postal%' OR body_text LIKE '%parcel post%') LIMIT 12;"
sqlite3 -readonly frus-copy.db "SELECT COUNT(*) FROM document_cache WHERE is_front_matter=0 AND is_editorial_note=0 AND body_text LIKE '%Manchukuo%' AND body_text LIKE '%postal%';"

