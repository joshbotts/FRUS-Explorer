sqlite3 -readonly -separator ' :: ' $D "SELECT f.volume_id, f.document_id, substr(replace(d.header,char(10),' '),1,95), substr(COALESCE(dd.date_iso,'?'),1,10) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id LEFT JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH '\"postal convention\" OR \"postal union\" OR \"postal treaty\" OR \"postal congress\" OR \"postal arrangement\" OR \"postal agreement\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND COALESCE(dd.date_iso,'1900') >= '1900' ORDER BY dd.date_iso;"

