# --- 27. THE 1874 FOUNDING (S)
sqlite3 -readonly -separator ' :: ' $D "SELECT f.volume_id, f.document_id, substr(replace(d.header,char(10),' '),1,80), COALESCE(dt.date_iso,'?') FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id LEFT JOIN document_dates dt ON dt.volume_id=f.volume_id AND dt.document_id=f.document_id WHERE frus_documents MATCH '\"General Postal Union\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 ORDER BY dt.date_iso;"
sqlite3 -readonly -separator ' :: ' $D "SELECT f.volume_id, f.document_id, substr(replace(d.header,char(10),' '),1,70), COALESCE(dt.date_iso,'?') FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id LEFT JOIN document_dates dt ON dt.volume_id=f.volume_id AND dt.document_id=f.document_id WHERE frus_documents MATCH 'postal AND (Berne OR Bern)' AND d.is_front_matter=0 AND d.is_editorial_note=0 ORDER BY dt.date_iso LIMIT 25;"
sqlite3 -readonly -separator '|' $D "SELECT f.volume_id, COUNT(*) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'postal' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND f.volume_id IN ('frus1873p1v1','frus1873p1v2','frus1873p2','frus1874','frus1875v01','frus1875v02','frus1876','frus1877','frus1878','frus1879') GROUP BY 1 ORDER BY 1;"
sqlite3 -readonly $D "SELECT COUNT(*) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'postal' AND f.volume_id='frus1874' AND (d.is_front_matter=1 OR d.is_editorial_note=1);"

# --- 28. TWO MORE WHOLE-DOCUMENT READS (S) — first attempt mis-named the files (zsh word splitting), redone
sqlite3 -readonly -separator '|' $D "SELECT volume_id, document_id, length(body_text), substr(replace(header,char(10),' '),1,90) FROM document_cache WHERE (volume_id='frus1951v02' AND document_id IN ('d181','d138')) OR (volume_id='frus1952-54v03' AND document_id='d48');"
sqlite3 -readonly "$D" "SELECT body_text FROM document_cache WHERE volume_id='frus1951v02' AND document_id='d181';" > "$SD/read-frus1951v02-d181.txt"
sqlite3 -readonly "$D" "SELECT body_text FROM document_cache WHERE volume_id='frus1952-54v03' AND document_id='d48';" > "$SD/read-frus1952-54v03-d48.txt"
head -c 1300 "$SD/read-frus1951v02-d181.txt"
grep -o -E '.{150}[Pp]ostal.{350}' "$SD/read-frus1952-54v03-d48.txt" | head -1

# --- 29. TOP-VOLUME SHARE OF EACH DECADE'S NUMERATOR (S)
sqlite3 -readonly -separator '|' $D "WITH hits AS (SELECT f.volume_id v, f.document_id dd FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"postal convention\" OR \"postal union\" OR \"postal treaty\" OR \"postal congress\" OR \"postal arrangement\" OR \"postal agreement\"' AND d.is_front_matter=0 AND d.is_editorial_note=0), hd AS (SELECT h.v, substr(dt.date_iso,1,3)||'0' dec FROM hits h JOIN document_dates dt ON dt.volume_id=h.v AND dt.document_id=h.dd WHERE dt.date_iso IS NOT NULL), per AS (SELECT dec, v, COUNT(*) c FROM hd GROUP BY dec, v), tot AS (SELECT dec, SUM(c) t FROM per GROUP BY dec) SELECT tot.dec, tot.t AS decade_hits, (SELECT v FROM per p WHERE p.dec=tot.dec ORDER BY c DESC, v LIMIT 1) AS top_vol, (SELECT c FROM per p WHERE p.dec=tot.dec ORDER BY c DESC, v LIMIT 1) AS top_vol_hits FROM tot ORDER BY tot.dec;"

