# --- 5. PHRASE FAMILY COUNTS (S) — bash loop over 15 phrases $P, each run as:
for P in "postal convention" "postal union" "Universal Postal Union" "General Postal Union" "Postmaster General" "Post Office Department" "parcel post" "postal service" "postal treaty" "postal agreement" "postal congress" "postal arrangement" "money order" "postal rates" "postal card"; do sqlite3 -readonly $D "SELECT COUNT(*)||'|'||COUNT(DISTINCT f.volume_id) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"$P\"' AND d.is_front_matter=0 AND d.is_editorial_note=0;"; done

# --- 6. NEGOTIATION-CORE FAMILY: volumes + total (S)
sqlite3 -readonly $D "SELECT f.volume_id, COUNT(*) AS n FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"postal convention\" OR \"postal union\" OR \"postal treaty\" OR \"postal congress\" OR \"postal arrangement\" OR \"postal agreement\"' AND d.is_front_matter=0 AND d.is_editorial_note=0 GROUP BY f.volume_id ORDER BY n DESC LIMIT 30;"
sqlite3 -readonly $D "SELECT COUNT(*), COUNT(DISTINCT f.volume_id) FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"postal convention\" OR \"postal union\" OR \"postal treaty\" OR \"postal congress\" OR \"postal arrangement\" OR \"postal agreement\"' AND d.is_front_matter=0 AND d.is_editorial_note=0;"

# --- 7. DECADE SHAPE, raw + per-1,000 of that decade's dated non-apparatus documents (S)
sqlite3 -readonly $D "WITH hits AS (SELECT f.volume_id, f.document_id FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '\"postal convention\" OR \"postal union\" OR \"postal treaty\" OR \"postal congress\" OR \"postal arrangement\" OR \"postal agreement\"' AND d.is_front_matter=0 AND d.is_editorial_note=0), den AS (SELECT substr(dd.date_iso,1,3)||'0' AS dec, COUNT(*) AS m FROM document_dates dd JOIN document_cache d ON d.volume_id=dd.volume_id AND d.document_id=dd.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND dd.date_iso IS NOT NULL GROUP BY dec), num AS (SELECT substr(dd.date_iso,1,3)||'0' AS dec, COUNT(*) AS n FROM hits h JOIN document_dates dd ON dd.volume_id=h.volume_id AND dd.document_id=h.document_id WHERE dd.date_iso IS NOT NULL GROUP BY dec) SELECT den.dec, COALESCE(num.n,0) AS hits, den.m AS dated_docs, ROUND(1000.0*COALESCE(num.n,0)/den.m,3) AS per_1000 FROM den LEFT JOIN num ON num.dec=den.dec ORDER BY den.dec;"
sqlite3 -readonly $D ".schema document_dates"

