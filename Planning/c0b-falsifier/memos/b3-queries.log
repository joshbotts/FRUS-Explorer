python3 -c "
import json,re
d=json.load(open(\"/Applications/FRUS Explorer.app/Contents/Resources/manifest.json\"))
m={v[\"filename\"][:-4]:v for v in d}
for vid in [\"frus1944v02\",\"frus1964-68v14\",\"frus1969-76ve01\",\"frus1961-63v05\",\"frus1945v02\",\"frus1946v11\",\"frus1949v05\",\"frus1924v01\",\"frus1929v01\",\"frus1981-88v04\",\"frus1981-88v05\",\"frus1977-80v13\",\"frus1919Parisv11\",\"frus1946v01\",\"frus1948v04\",\"frus1952-54v01p1\",\"frus1940v04\",\"frus1935v03\"]:
    v=m.get(vid)
    if v: print(vid,\"|\",v[\"dateRange\"][\"earliest\"][:4]+\"-\"+v[\"dateRange\"][\"latest\"][:4],\"|\",re.sub(r\"\s+\",\" \",v[\"title\"]))
    else: print(vid,\"| MISSING\")
"
