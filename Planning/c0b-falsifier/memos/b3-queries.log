    if pat.search(e[\"n\"]) or pat.search(e.get(\"c\",\"\")) or pat.search(e.get(\"s\",\"\")):
        print(i, e[\"c\"], \"|\", e.get(\"s\"), \"|\", e[\"n\"], \"df=\", e[\"df\"])
"
