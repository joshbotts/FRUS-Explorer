sqlite3 -readonly frus-copy.db "WITH base AS (SELECT d.rowid rid, d.volume_id, substr(dd.date_iso,1,3)||'0' dec FROM document_cache d JOIN document_dates dd ON dd.volume_id=d.volume_id AND dd.document_id=d.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') AND dd.date_iso IS NOT NULL AND length(dd.date_iso)>=4), hit AS (SELECT rowid rid FROM frus_documents WHERE frus_documents MATCH 'refugee'), hit2 AS (SELECT rowid rid FROM frus_documents WHERE frus_documents MATCH '\"displaced persons\"') SELECT dec, COUNT(*), SUM(rid IN (SELECT rid FROM hit)), ROUND(1000.0*SUM(rid IN (SELECT rid FROM hit))/COUNT(*),2), SUM(rid IN (SELECT rid FROM hit2)) FROM base GROUP BY dec ORDER BY dec;"
