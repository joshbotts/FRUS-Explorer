sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "SELECT structure_json FROM volume_structures;" > /dev/null; python3 - <<PY
import json,sqlite3,re
db=sqlite3.connect("file:/Users/jbotts/frus-analysis/frus-copy.db")
rows=db.execute("SELECT volume_id, structure_json FROM volume_structures").fetchall()
pat=re.compile(r"refugee|displaced person|asylum|expatriat|emigra|repatriat|resettle|escapee|stateless|migration|exile|evacuee|immigra", re.I)
out=[]
def walk(node, vid):
    t=re.sub(r"\s+"," ",(node.get("title") or "")).strip()
    ids=node.get("documentIds") or []
    if t and pat.search(t):
        out.append((vid, node.get("divType"), len(ids), t))
    for s in node.get("subsections") or []:
        walk(s, vid)
for vid, sj in rows:
    d=json.loads(sj)
    for s in d.get("sections") or []:
        walk(s, vid)
print("MATCHING HEADINGS:", len(out))
for vid,dt,n,t in sorted(out):
    print(f"{vid}|{dt}|{n}|{t[:150]}")
PY
