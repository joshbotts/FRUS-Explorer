sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "WITH hit AS (SELECT f.volume_id v, f.document_id x, substr(dd.date_iso,1,3) dc FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id JOIN document_dates dd ON dd.volume_id=f.volume_id AND dd.document_id=f.document_id WHERE frus_documents MATCH 'refugee' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') AND dd.date_iso IS NOT NULL), pv AS (SELECT dc, v, COUNT(*) n FROM hit GROUP BY 1,2), tot AS (SELECT dc, COUNT(*) n FROM hit GROUP BY 1) SELECT tot.dc||'0s', tot.n, (SELECT v FROM pv WHERE pv.dc=tot.dc ORDER BY n DESC LIMIT 1) topvol, (SELECT MAX(n) FROM pv WHERE pv.dc=tot.dc) topn, ROUND(100.0*(SELECT MAX(n) FROM pv WHERE pv.dc=tot.dc)/tot.n,1)||'%' share FROM tot ORDER BY 1;"
