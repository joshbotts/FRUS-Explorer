sqlite3 -readonly /Users/jbotts/frus-analysis/frus-copy.db "
CREATE TEMP TABLE r AS SELECT volume_id, document_id FROM frus_documents WHERE frus_documents MATCH 'refugee';
SELECT 'refugee docs with a source row', count(*) FROM r JOIN document_sources s USING(volume_id,document_id);
SELECT '--- top decimal classes ---';
SELECT s.decimal_class, count(*) c FROM r JOIN document_sources s USING(volume_id,document_id) WHERE s.decimal_class IS NOT NULL AND s.decimal_class<>'' GROUP BY 1 ORDER BY c DESC LIMIT 25;
SELECT '--- top lot files ---';
SELECT s.lot_file_norm, count(*) c FROM r JOIN document_sources s USING(volume_id,document_id) WHERE s.lot_file_norm IS NOT NULL AND s.lot_file_norm<>'' GROUP BY 1 ORDER BY c DESC LIMIT 20;
SELECT '--- top repositories ---';
SELECT s.repository, count(*) c FROM r JOIN document_sources s USING(volume_id,document_id) WHERE s.repository IS NOT NULL AND s.repository<>'' GROUP BY 1 ORDER BY c DESC LIMIT 15;
"
