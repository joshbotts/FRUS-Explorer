sqlite3 -readonly DB "WITH hits AS (SELECT d.volume_id v, d.document_id i, substr(dd.date_iso,1,3) dec FROM frus_documents f JOIN document_cache d ON d.volume_id=f.volume_id AND d.document_id=f.document_id JOIN document_dates dd ON dd.volume_id=d.volume_id AND dd.document_id=d.document_id WHERE frus_documents MATCH '(USIA OR USIS OR "information program" OR "psychological warfare" OR "psychological strategy" OR "psychological operations" OR "voice of america" OR "public diplomacy" OR "cultural exchange" OR "information agency" OR "information activities" OR "image of the united states" OR "american image" OR "U.S. image") AND (asia OR asian OR "far east" OR japan OR japanese OR china OR chinese OR korea OR korean OR vietnam OR vietnamese OR indochina OR philippines OR indonesia OR thailand OR laos OR cambodia OR burma OR malaya OR malaysia OR singapore OR taiwan OR australia OR pacific)' AND d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')), base AS (SELECT substr(dd.date_iso,1,3) dec, COUNT(*) n FROM document_cache d JOIN document_dates dd ON dd.volume_id=d.volume_id AND dd.document_id=d.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') GROUP BY 1) SELECT h.dec||'0s', COUNT(*), b.n, round(1000.0*COUNT(*)/b.n,1), (SELECT MAX(c) FROM (SELECT COUNT(*) c FROM hits h2 WHERE h2.dec=h.dec GROUP BY h2.v)) topvol FROM hits h JOIN base b ON b.dec=h.dec GROUP BY h.dec ORDER BY h.dec;"
