== external_citations schema and earliest document date among rows (house figure 1910-12-06) ==
CREATE TABLE external_citations (
    volume_id     TEXT NOT NULL,
    document_id   TEXT NOT NULL,
    note_ordinal  INTEGER NOT NULL,
    citation_index INTEGER NOT NULL,
    anchor        TEXT NOT NULL,
    repository    TEXT,
    collection    TEXT,
    lot_file      TEXT,
    lot_file_norm TEXT,
    file_id       TEXT,
    inherited     INTEGER NOT NULL DEFAULT 0,
    raw_text      TEXT NOT NULL, decimal_class TEXT, note_label TEXT,
    PRIMARY KEY (volume_id, document_id, note_ordinal, citation_index)
)
