SELECT COUNT(*), COUNT(DISTINCT f.volume_id), MIN(d.volume_id), MAX(d.volume_id) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND frus_documents MATCH ?
