SELECT f.volume_id, f.document_id, substr(replace(d.header,char(10),' '),1,100), d.dateline FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND frus_documents MATCH ? ORDER BY bm25(frus_documents) LIMIT 12 ("Boxer indemnity" OR "indemnity" ) AND (students OR education OR educational OR university OR scholarships) AND China
