SELECT f.volume_id, f.document_id, bm25(frus_documents) s, substr(replace(d.header,char(10),' '),1,110), d.dateline FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid JOIN R ON R.volume_id=d.volume_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND frus_documents MATCH ? ORDER BY s LIMIT 200
