sqlite3 -readonly DB "SELECT count(distinct volume_id) FROM document_cache WHERE volume_id < 'frus1895' AND volume_id LIKE 'frus1%' ;"
sqlite3 -readonly DB "SELECT c.volume_id, count(*) FROM frus_documents d JOIN document_cache c ON c.rowid=d.rowid WHERE frus_documents MATCH 'body_text:(recognition OR recognize) AND body_text:(revolution OR "provisional government" OR "de facto") AND body_text:(venezuela OR mexico OR peru OR chile OR colombia OR bolivia OR ecuador OR haiti OR nicaragua OR honduras OR guatemala OR salvador OR paraguay OR uruguay OR argentine OR brazil OR cuba OR dominican OR panama OR "costa rica")' AND c.volume_id < 'frus1895' AND c.is_front_matter=0 AND c.is_editorial_note=0 GROUP BY c.volume_id ORDER BY c.volume_id;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, substr(replace(c.header,char(10),' '),1,80), substr(c.dateline,1,40), round(bm25(frus_documents),1) FROM frus_documents d JOIN document_cache c ON c.rowid=d.rowid WHERE frus_documents MATCH 'body_text:(recognition AND diaz AND mexico AND (claims OR border OR frontier))' AND c.volume_id IN ('frus1876','frus1877','frus1878') AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "SELECT count(*), min(dd.date_iso), max(dd.date_iso), sum(dd.date_iso IS NULL) FROM s.scope s JOIN document_cache c ON c.volume_id=s.volume_id AND c.document_id=s.document_id AND c.is_front_matter=0 AND c.is_editorial_note=0 LEFT JOIN document_dates dd ON dd.volume_id=s.volume_id AND dd.document_id=s.document_id;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "SELECT count(distinct s.volume_id) FROM s.scope s JOIN document_cache c ON c.volume_id=s.volume_id AND c.document_id=s.document_id AND c.is_front_matter=0 AND c.is_editorial_note=0; "
sqlite3 -readonly DB (ATTACH scope.db AS s) "SELECT count(*) FROM (SELECT distinct volume_id FROM s.scope) WHERE volume_id LIKE '%Ed2%';"
sqlite3 -readonly DB (ATTACH scope.db AS s) "WITH num AS (
 SELECT (CAST(substr(dd.date_iso,1,4) AS INT)/10)*10 dec, s.volume_id, count(*) n
 FROM s.scope s JOIN document_cache c ON c.volume_id=s.volume_id AND c.document_id=s.document_id AND c.is_front_matter=0 AND c.is_editorial_note=0
 JOIN document_dates dd ON dd.volume_id=s.volume_id AND dd.document_id=s.document_id
 GROUP BY 1,2),
den AS (
 SELECT (CAST(substr(dd.date_iso,1,4) AS INT)/10)*10 dec, count(*) d
 FROM document_cache c JOIN document_dates dd ON dd.volume_id=c.volume_id AND dd.document_id=c.document_id
 WHERE c.is_front_matter=0 AND c.is_editorial_note=0 AND dd.date_iso IS NOT NULL GROUP BY 1)
SELECT num.dec, sum(num.n) numer, den.d denom, round(1000.0*sum(num.n)/den.d,1) per1000,
 (SELECT n FROM num n2 WHERE n2.dec=num.dec ORDER BY n DESC LIMIT 1) topvol_n,
 (SELECT volume_id FROM num n2 WHERE n2.dec=num.dec ORDER BY n DESC LIMIT 1) topvol,
 round(1.0*(SELECT n FROM num n2 WHERE n2.dec=num.dec ORDER BY n DESC LIMIT 1)/sum(num.n),2) topshare
FROM num JOIN den ON den.dec=num.dec GROUP BY num.dec ORDER BY num.dec;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "WITH sv AS (SELECT DISTINCT volume_id FROM s.scope), pos AS (SELECT c.volume_id v, count(*) n FROM frus_documents d JOIN document_cache c ON c.rowid=d.rowid WHERE frus_documents MATCH '"department of state"' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM sv) GROUP BY 1) SELECT (SELECT count(*) FROM sv) nvol, count(*) vols_with_pos, min(n) min_pos, sum(n) total_pos FROM pos;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "SELECT count(*) FROM frus_documents d JOIN document_cache c ON c.rowid=d.rowid WHERE frus_documents MATCH '"ZZZ_IMPOSSIBLE_ZZZ"' AND c.volume_id IN (SELECT volume_id FROM s.scope);"
sqlite3 -readonly DB (ATTACH scope.db AS s) "WITH sv AS (SELECT DISTINCT volume_id FROM s.scope), pos AS (SELECT c.volume_id v, count(*) n FROM frus_documents d JOIN document_cache c ON c.rowid=d.rowid WHERE frus_documents MATCH '"department of state"' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM sv) GROUP BY 1) SELECT sv.volume_id FROM sv LEFT JOIN pos ON pos.v=sv.volume_id WHERE pos.n IS NULL OR pos.n=0;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "WITH hit AS (SELECT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'recogn*' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM s.scope)), allv AS (SELECT c.volume_id v, c.document_id d, (s.volume_id IS NOT NULL) insc FROM document_cache c LEFT JOIN s.scope s ON s.volume_id=c.volume_id AND s.document_id=c.document_id WHERE c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM s.scope)) SELECT allv.insc, count(*) total, sum(hit.v IS NOT NULL) hits FROM allv LEFT JOIN hit ON hit.v=allv.v AND hit.d=allv.d GROUP BY 1;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "WITH hit AS (SELECT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH '"department of state"' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM s.scope)), allv AS (SELECT c.volume_id v, c.document_id d, (s.volume_id IS NOT NULL) insc FROM document_cache c LEFT JOIN s.scope s ON s.volume_id=c.volume_id AND s.document_id=c.document_id WHERE c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM s.scope)) SELECT allv.insc, count(*) total, sum(hit.v IS NOT NULL) hits FROM allv LEFT JOIN hit ON hit.v=allv.v AND hit.d=allv.d GROUP BY 1;"
sqlite3 -readonly DB (ATTACH scope.db AS s) "WITH hit AS (SELECT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH '"international obligations"' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM s.scope)), allv AS (SELECT c.volume_id v, c.document_id d, (s.volume_id IS NOT NULL) insc FROM document_cache c LEFT JOIN s.scope s ON s.volume_id=c.volume_id AND s.document_id=c.document_id WHERE c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id IN (SELECT volume_id FROM s.scope)) SELECT allv.insc, count(*) total, sum(hit.v IS NOT NULL) hits FROM allv LEFT JOIN hit ON hit.v=allv.v AND hit.d=allv.d GROUP BY 1;"
