python3 -I scripts/build_editors_set.py
sqlite3 -readonly -header /Users/jbotts/frus-analysis/c3/frus-copy-2026-10-25.db "ATTACH 'file:/Users/jbotts/frus-analysis/c3/runs/r1/work/scope.db?mode=ro' AS s; SELECT COUNT(*) AS docs_under_editors_recognition_headings, COUNT(DISTINCT e.volume_id) AS volumes, SUM(sd.numbered=1 AND sd.apparatus=0 AND sd.ed2_dup=0) AS numbered_nonapparatus, SUM(sd.numbered=1 AND sd.apparatus=0 AND sd.ed2_dup=0 AND sd.latam=1) AS also_in_latam_scope FROM s.editors_recog e JOIN s.scope_docs sd ON sd.volume_id=e.volume_id AND sd.document_id=e.document_id;"
sqlite3 -readonly -header /Users/jbotts/frus-analysis/c3/frus-copy-2026-10-25.db "ATTACH 'file:/Users/jbotts/frus-analysis/c3/runs/r1/work/scope.db?mode=ro' AS s; WITH h AS (SELECT sd.decade AS decade, e.volume_id AS volume_id, COUNT(*) AS n FROM s.editors_recog e JOIN s.scope_docs sd ON sd.volume_id=e.volume_id AND sd.document_id=e.document_id WHERE sd.numbered=1 AND sd.apparatus=0 AND sd.ed2_dup=0 AND sd.date_iso IS NOT NULL GROUP BY 1,2) SELECT decade, SUM(n) AS docs_under_editors_recognition_headings, (SELECT COUNT(*) FROM s.scope_docs x WHERE x.latam=1 AND x.numbered=1 AND x.apparatus=0 AND x.ed2_dup=0 AND x.date_iso IS NOT NULL AND x.decade=h.decade) AS latam_dated_docs_in_decade, ROUND(1000.0*SUM(n)/(SELECT COUNT(*) FROM s.scope_docs x WHERE x.latam=1 AND x.numbered=1 AND x.apparatus=0 AND x.ed2_dup=0 AND x.date_iso IS NOT NULL AND x.decade=h.decade),1) AS per_1000, COUNT(*) AS volumes, MAX(n) AS top_volume_docs, (SELECT volume_id FROM h h2 WHERE h2.decade=h.decade ORDER BY n DESC, volume_id LIMIT 1) AS top_volume, ROUND(1.0*MAX(n)/SUM(n),2) AS top_share FROM h GROUP BY decade ORDER BY decade;"
