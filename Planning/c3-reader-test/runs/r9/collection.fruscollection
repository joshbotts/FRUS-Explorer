   ]
  },
  {
   "kind": "excerpt",
   "volumeId": "frus1877",
   "documentId": "d216",
   "text": "you would be warranted in recognizing the government of Porfirio Diaz, unless before this reaches you such a step should be made inexpedient by events which are not now foreseen"
  },
