sqlite3 -readonly DB "SELECT f.volume_id||'/'||f.document_id, c.is_editorial_note, substr(d.date_iso,1,10) FROM frus_documents f JOIN document_cache c ON c.volume_id=f.volume_id AND c.document_id=f.document_id LEFT JOIN document_dates d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH 'Estrada AND recogni*' AND c.is_front_matter=0 AND d.date_iso BETWEEN '1929-01-01' AND '1931-06-30' ORDER BY d.date_iso;"
sqlite3 -readonly DB "SELECT f.volume_id||'/'||f.document_id, c.is_editorial_note, substr(d.date_iso,1,10) FROM frus_documents f JOIN document_cache c ON c.volume_id=f.volume_id AND c.document_id=f.document_id LEFT JOIN document_dates d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '"Resolution XXVI"' AND c.is_front_matter=0 AND d.date_iso BETWEEN '1929-01-01' AND '1931-06-30' ORDER BY d.date_iso;"
sqlite3 -readonly DB "SELECT f.volume_id||'/'||f.document_id, c.is_editorial_note, substr(d.date_iso,1,10) FROM frus_documents f JOIN document_cache c ON c.volume_id=f.volume_id AND c.document_id=f.document_id LEFT JOIN document_dates d ON d.volume_id=f.volume_id AND d.document_id=f.document_id WHERE frus_documents MATCH '"Resolution 26"' AND c.is_front_matter=0 AND d.date_iso BETWEEN '1929-01-01' AND '1931-06-30' ORDER BY d.date_iso;"
sqlite3 -readonly DB "SELECT f.volume_id||'/'||f.document_id FROM frus_documents f WHERE frus_documents MATCH '"Resolution XXVI" OR "Resolution 26"';"
