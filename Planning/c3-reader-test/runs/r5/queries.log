python3 inline: scope_sections.tsv -> scope_docs.tsv (docs in the curated sections via struct.db sd, minus is_front_matter/is_editorial_note, existence checked in document_cache)
sqlite3 -readonly DB "select citation_era,count(*) from document_sources group by 1 order by 2 desc; "
sqlite3 -readonly DB "select count(*),count(distinct volume_id) from document_sources; "
python3 scopedb.py (scope.db tables scope=scope_docs.tsv, core=core_docs.txt)
python sqlite3 scope.db + ATTACH main index mode=ro as m: select count(*), sum(ds.volume_id is not null) from scope s left join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id 
python sqlite3 scope.db + ATTACH main index mode=ro as m: select ds.citation_era,count(*) from scope s join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id group by 1 order by 2 desc 
python sqlite3 scope.db + ATTACH main index mode=ro as m: select ds.repository, ds.record_group, count(*) from scope s join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id group by 1,2 order by 3 desc limit 10 
python sqlite3 scope.db + ATTACH main index mode=ro as m: select ds.decimal_class, count(*), min(s.volume_id), max(s.volume_id) from scope s join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id group by 1 order by 2 desc limit 25 
python sqlite3 scope.db + ATTACH main index mode=ro as m: select ds.raw_text, s.volume_id, s.document_id from scope s join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id where s.volume_id in ('frus1920v01','frus1944v07','frus1948v09') limit 5 
python3 inspect decimal-class-labels.json keys/coverage
python3 decimal_gloss.py (scope docs: document_sources.decimal_class grouped; country number glossed from decimal-class-labels.json schedule 1910-1949 only when first and last dated year of the group fall inside it)
python3 inspect collection-usage-index.json/central-files-index.json top-level
python3 usage_scope.py (collection-usage-index.json restricted to the 38 scope volumes; names from collection-authority.json)
grep -l 'Decimal File' *.json (resources)
python3 inline: search collection-authority.json / central-files-index.json lotFiles for 'Decimal'; series-facts legend
python sqlite3 scope.db + ATTACH main index mode=ro as m: select ds.citation_era, ds.repository, ds.record_group, ds.lot_file_norm, ds.series_name, count(*) c, group_concat(distinct s.volume_id) from scope s join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id where ds.citation_era<>'decimal' group by 1,2,3,4,5 order by c desc 
python sqlite3 scope.db + ATTACH main index mode=ro as m: select s.volume_id,s.document_id,ds.citation_era,ds.repository,ds.record_group,ds.lot_file_norm,substr(ds.series_name,1,60),substr(replace(ds.raw_text,char(10),' '),1,70) from core s left join m.document_sources ds on ds.volume_id=s.volume_id and ds.document_id=s.document_id order by s.volume_id 
python sqlite3 scope.db + ATTACH main index mode=ro as m: select count(distinct e.volume_id||'/'||e.document_id), count(*), min(s.volume_id), max(s.volume_id) from scope s join m.external_citations e on e.volume_id=s.volume_id and e.document_id=s.document_id 
