WITH base AS (SELECT d.volume_id, d.document_id, substr(dd.date_iso,1,3)||'0s' dec FROM document_cache d JOIN document_dates dd ON dd.volume_id=d.volume_id AND dd.document_id=d.document_id WHERE d.is_front_matter=0 AND d.is_editorial_note=0 AND d.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') AND dd.date_iso IS NOT NULL AND dd.date_iso<>''),
hits AS (SELECT d.volume_id, d.document_id FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE frus_documents MATCH 'corrupt OR bribe OR bribery OR kickback OR embezzle OR malfeasance OR peculation OR graft' AND d.is_front_matter=0 AND d.is_editorial_note=0)
SELECT b.dec, COUNT(*) denom, SUM(CASE WHEN h.document_id IS NOT NULL THEN 1 ELSE 0 END) n, ROUND(1000.0*SUM(CASE WHEN h.document_id IS NOT NULL THEN 1 ELSE 0 END)/COUNT(*),1) per1000 FROM base b LEFT JOIN hits h ON h.volume_id=b.volume_id AND h.document_id=b.document_id GROUP BY b.dec ORDER BY b.dec;
SELECT d.volume_id, COUNT(*) n, (SELECT COUNT(*) FROM document_cache x WHERE x.volume_id=d.volume_id AND x.is_front_matter=0 AND x.is_editorial_note=0) m FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE frus_documents MATCH 'corrupt' AND d.is_front_matter=0 AND d.is_editorial_note=0 GROUP BY d.volume_id ORDER BY n DESC LIMIT 40;
SELECT d.volume_id, d.document_id, substr(d.header,1,140) FROM frus_documents f JOIN document_cache d ON d.rowid=f.rowid WHERE frus_documents MATCH 'header:(corrupt OR bribe OR bribery OR graft OR kickback OR embezzle OR scandal OR malfeasance OR nepotism OR peculation OR "improper payments" OR "illegal payments" OR "questionable payments")' AND d.is_front_matter=0 AND d.is_editorial_note=0 ORDER BY d.volume_id, d.document_id LIMIT 120;
