SQL: SELECT c.volume_id, c.document_id, c.header||' '||coalesce(c.dateline,'')||' '||coalesce(c.source_note,'')||' '||c.body_text FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH ? AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') ORDER BY c.volume_id, c.document_id param: corrupt*
corrupt: N=2186 strict=2159 of 2186 tolerant=2186 of 2186 garble_only=9 of 2186 venality_or_other=2177 of 2186
SAMPLE40 strict 40 of 40; tolerant 40 of 40; garble_only 0 of 40
