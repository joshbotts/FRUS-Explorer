sqlite3 "file:/Users/jbotts/frus-analysis/c3/frus-copy-2026-10-25.db?mode=ro" "WITH s AS (SELECT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt* OR brib* OR graft OR embezzl* OR kickback* OR "illicit payment"' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')), base AS (SELECT substr(dd.date_iso,1,3)||'0s' dec, COUNT(*) n FROM document_cache c JOIN document_dates dd ON dd.volume_id=c.volume_id AND dd.document_id=c.document_id WHERE c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') AND dd.date_iso IS NOT NULL GROUP BY 1), hv AS (SELECT substr(dd.date_iso,1,3)||'0s' dec, s.v, COUNT(*) n FROM s JOIN document_dates dd ON dd.volume_id=s.v AND dd.document_id=s.d WHERE dd.date_iso IS NOT NULL GROUP BY 1,2), h AS (SELECT dec, SUM(n) n, MAX(n) top FROM hv GROUP BY dec) SELECT base.dec, base.n, IFNULL(h.n,0), round(1000.0*IFNULL(h.n,0)/base.n,2), h.top, (SELECT v FROM hv WHERE hv.dec=h.dec ORDER BY n DESC LIMIT 1) FROM base LEFT JOIN h USING(dec) WHERE base.dec>='1840s' ORDER BY 1;"
