sqlite3 -readonly DB "SELECT c.volume_id, COUNT(*) n, (SELECT COUNT(*) FROM document_cache x WHERE x.volume_id=c.volume_id AND x.is_front_matter=0 AND x.is_editorial_note=0) tot FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt*' AND c.is_front_matter=0 AND c.is_editorial_note=0 GROUP BY c.volume_id ORDER BY n DESC LIMIT 25;"
sqlite3 -readonly DB "SELECT c.volume_id, COUNT(*) n FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'lockheed' AND c.is_front_matter=0 AND c.is_editorial_note=0 GROUP BY c.volume_id ORDER BY n DESC LIMIT 10;"
python3: load manifest.json keys/titles for top volumes
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,130), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'corrupt*' AND c.volume_id='frus1947v07' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,130), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'corrupt*' AND c.volume_id='frus1948v07' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,130), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'corrupt*' AND c.volume_id='frus1964-68v04' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,130), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'corrupt*' AND c.volume_id='frus1964-68v05' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,130), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'corrupt*' AND c.volume_id='frus1977-80v15' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,130), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'corrupt*' AND c.volume_id='frus1961-63v22' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 8;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,120), round(bm25(frus_documents),1) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH 'lockheed AND (briberi OR bribe* OR payment* OR scandal*)' AND c.is_front_matter=0 AND c.is_editorial_note=0 ORDER BY bm25(frus_documents) LIMIT 20;"
sqlite3 -readonly DB "SELECT c.volume_id||'/'||c.document_id, d.date_iso, substr(replace(c.header,char(10),' '),1,120) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates d ON d.volume_id=c.volume_id AND d.document_id=c.document_id WHERE frus_documents MATCH '"foreign corrupt practices"' AND c.is_front_matter=0 AND c.is_editorial_note=0;"
