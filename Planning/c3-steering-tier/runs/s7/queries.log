sqlite3 -readonly DB "WITH h AS (SELECT DISTINCT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt* OR briberi OR bribe*' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT coalesce(s.repository,'(none)'), coalesce(s.record_group,'-'), COUNT(*) FROM h JOIN document_sources s ON s.volume_id=h.v AND s.document_id=h.d WHERE s.citation_era='decimal' GROUP BY 1,2 ORDER BY 3 DESC LIMIT 5;"
