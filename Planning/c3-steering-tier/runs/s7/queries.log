python3 inline: 1960-1963 schedule gloss for 795B.00/751G.00; pointed-at decimal class date spans
python3 [gloss-pointed] SQL: WITH h AS (SELECT DISTINCT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt* OR briberi OR bribe*' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT substr(dd.date_iso,1,4)<'1960', COUNT(DISTINCT e.volume_id||'/'||e.document_id) FROM h JOIN external_citations e ON e.volume_id=h.v AND e.document_id=h.d JOIN document_dates dd ON dd.volume_id=h.v AND dd.document_id=h.d WHERE e.decimal_class=? GROUP BY 1  ARGS=('795B.00',)
python3 [gloss-pointed] SQL: WITH h AS (SELECT DISTINCT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt* OR briberi OR bribe*' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT substr(dd.date_iso,1,4)<'1960', COUNT(DISTINCT e.volume_id||'/'||e.document_id) FROM h JOIN external_citations e ON e.volume_id=h.v AND e.document_id=h.d JOIN document_dates dd ON dd.volume_id=h.v AND dd.document_id=h.d WHERE e.decimal_class=? GROUP BY 1  ARGS=('751G.00',)
sqlite3 -readonly DB "WITH h AS (SELECT DISTINCT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt* OR briberi OR bribe*' AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2')) SELECT e.decimal_class, MIN(dd.date_iso), MAX(dd.date_iso) FROM h JOIN external_citations e ON e.volume_id=h.v AND e.document_id=h.d JOIN document_dates dd ON dd.volume_id=h.v AND dd.document_id=h.d WHERE e.decimal_class IN ('795B.00','751G.00') GROUP BY 1;"
