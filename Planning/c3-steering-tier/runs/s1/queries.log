sqlite3 "file:/Users/jbotts/frus-analysis/c3/frus-copy-2026-10-25.db?mode=ro" "WITH hits AS (SELECT c.volume_id v, c.document_id d FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt' AND c.is_front_matter=0 AND c.is_editorial_note=0), base AS (SELECT substr(t.date_iso,1,3)||'0s' dec, COUNT(*) n FROM document_cache c JOIN document_dates t ON t.volume_id=c.volume_id AND t.document_id=c.document_id WHERE c.is_front_matter=0 AND c.is_editorial_note=0 GROUP BY 1), h AS (SELECT substr(t.date_iso,1,3)||'0s' dec, COUNT(*) n FROM hits JOIN document_dates t ON t.volume_id=hits.v AND t.document_id=hits.d GROUP BY 1) SELECT base.dec, base.n AS dated_docs, COALESCE(h.n,0) AS hits, round(1000.0*COALESCE(h.n,0)/base.n,1) AS per1000 FROM base LEFT JOIN h USING(dec) ORDER BY 1;"
sqlite3 "file:/Users/jbotts/frus-analysis/c3/frus-copy-2026-10-25.db?mode=ro" "SELECT c.volume_id, COUNT(*) hits, (SELECT COUNT(*) FROM document_cache x WHERE x.volume_id=c.volume_id AND x.is_front_matter=0 AND x.is_editorial_note=0) tot FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH 'corrupt' AND c.is_front_matter=0 AND c.is_editorial_note=0 GROUP BY c.volume_id ORDER BY hits DESC LIMIT 45;"
