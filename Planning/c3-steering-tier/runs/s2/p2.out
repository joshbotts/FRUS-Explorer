SQL template: SELECT c.volume_id, c.document_id, t.date_iso, substr(c.header,1,110), snippet(frus_documents, 6, '[', ']', '…', 30), bm25(frus_documents) AS score FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates t ON t.volume_id=c.volume_id AND t.document_id=c.document_id WHERE frus_documents MATCH ? AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT LIKE '%Ed2' {vol} ORDER BY score ASC LIMIT {k}
