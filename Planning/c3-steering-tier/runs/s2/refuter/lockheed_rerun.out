SQL: SELECT c.volume_id, c.document_id, t.date_iso, c.header||' '||COALESCE(c.dateline,'')||' '||COALESCE(c.source_note,'')||' '||c.body_text FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid LEFT JOIN document_dates t ON t.volume_id=c.volume_id AND t.document_id=c.document_id WHERE frus_documents MATCH ? AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1
N=50; literal Lockheed + one of the words: 42 of 50; referent (Lockheed + bribe/scandal/corrupt/payoff wording): 27 of 50
referent volumes: [('frus1969-76ve12', 10), ('frus1969-76ve09p2', 7), ('frus1969-76ve09p1', 3), ('frus1969-76ve15p2', 3), ('frus1969-76v31', 2), ('frus1969-76v18', 1), ('frus1977-80v18', 1)]
