SQL: SELECT c.volume_id, c.document_id, c.header||' '||COALESCE(c.dateline,'')||' '||COALESCE(c.source_note,'')||' '||c.body_text FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH ? AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') ORDER BY c.volume_id, c.document_id
MATCH "questionable payments": N=9 (census)  STRICT 1 of 9  TOLERANT 1 of 9  | tolerant misses: ['frus1919Parisv11/d76', 'frus1941v01/d479', 'frus1947v08/d338', 'frus1949v08/d1651', 'frus1952-54v04/d465', 'frus1955-57v03mSupp/d813', 'frus1955-57v16/d386', 'frus1955-57v26/d156']
   STRICT re: \bquestionable payments\b  TOLERANT re: \bquestionabl\w*[\s\-,().]+payments?\b
MATCH "foreign corrupt practices": N=4 (census)  STRICT 4 of 4  TOLERANT 4 of 4  | tolerant misses: []
   STRICT re: \bforeign corrupt practices\b  TOLERANT re: \bforeign[\s\-,().]+corrupt\w*[\s\-,().]+practices?\b
   hits: ['frus1977-80v03/d152', 'frus1977-80v03/d230', 'frus1977-80v03/d248', 'frus1977-80v18/d57']
