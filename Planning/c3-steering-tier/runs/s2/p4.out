SQL: SELECT COUNT(*), COUNT(DISTINCT c.volume_id) FROM frus_documents f JOIN document_cache c ON c.rowid=f.rowid WHERE frus_documents MATCH ? AND c.is_front_matter=0 AND c.is_editorial_note=0 AND c.volume_id NOT IN ('frus1951-54IranEd2','frus1969-76ve15p2Ed2') AND c.volume_id LIKE ?
"foreign corrupt practices" frus1981-88% (0, 0)
"corrupt practices" frus1981-88% (1, 1)
corrupt OR bribe OR briberi frus1981-88% (59, 11)
ALL non-apparatus docs frus1981-88% (4140, 13)
lockheed AND (bernhard OR netherlands OR dutch) % (13, 8)
lockheed AND (italy OR italian) % (20, 15)
lockheed % (190, 78)
"church committee" AND (bribe OR bribery OR payments) % (3, 2)
"church committee" % (42, 15)
"anti corruption" OR anticorruption % (55, 29)
(bribe OR bribery) AND (consul OR consular) AND (fee OR fees) % (27, 21)
bribe OR bribery % (654, 280)
ZZZ_IMPOSSIBLE_ZZZ % (0, 0)
"department of state" % (93824, 550)
