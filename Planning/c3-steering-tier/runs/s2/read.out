SQL: SELECT c.header, COALESCE(c.dateline,''), COALESCE(c.source_note,''), c.body_text, length(c.body_text), t.date_iso FROM document_cache c LEFT JOIN document_dates t ON t.volume_id=c.volume_id AND t.document_id=c.document_id WHERE c.volume_id=? AND c.document_id=?
