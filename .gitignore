# Xcode
*.xcuserdata/
*.xccheckout
*.xcscmblueprint
DerivedData/
# A repo-local `xcodebuild -derivedDataPath` (scratch build output). The line above only matches
# Xcode's DEFAULT directory name — a custom path inside the repo is otherwise fully committable,
# and once swept 13,579 build artifacts into a staged commit (#511). Prefer pointing derived data
# outside the repo entirely; these patterns are the backstop for when it lands inside.
DerivedData*/
.dd/
dd-*/
*.moved-aside
xcuserdata/

# SPM
.build/
.swiftpm/

# CentralFilesIndexGenerator raw-page cache (regenerable harvest scratch)
.cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Archives and distributions
*.ipa
*.dSYM.zip
*.dSYM
*.dmg

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Notarization
notarization-*.json

# SourceNoteEvalGenerator scratch output at the repo root (the committed BEFORE/AFTER
# snapshots live at SourceNoteKit/eval-baseline.txt and SourceNoteKit/eval-report.txt)
/eval-report.txt

# #335: the full corpus-wide Source Explorer export is ~182MB — regenerate with
# SourceExplorerExportGenerator; only the summary + sample are committed.
Planning/source-explorer-export/source-explorer-export.json

# Claude Design hand-off bundles. Plan docs cite these as source of truth by repo-relative
# path, so unpack them at the repo root — but they are reference material (prototype HTML,
# 2x screenshots, runtime JS), not sources, and none has ever been committed. Each plan
# names the archive it came from under "Source of truth"; see e.g.
# Planning/Onboarding-Glass-Flow-Plan.md.
design_handoff_*/
