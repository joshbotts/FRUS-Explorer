<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    FRUS Explorer — App Store Entitlements
    Used by: iOS/iPadOS target (all configs), macOS target (Debug + AppStore configs)

    NARA API key storage note: items stored in the keychain with kSecAttrSynchronizable=true
    sync across the user's devices via iCloud Keychain automatically — no special entitlement
    is required for this. The keychain-access-groups entitlement below governs which access
    group the NARA key is stored in; the iCloud sync is handled at the item level in code.
-->
<dict>
    <!-- Sandbox: required for all Mac App Store submissions -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound network: GitHub API, NARA Catalog API -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
        Read/write access to files selected via NSSavePanel / NSOpenPanel.
        Required for collection exports: MacExportCompleteView's "Save To…" button copies
        the exported PDF/HTML from temporaryDirectory to the user-chosen destination.
        Without this, FileManager.copyItem crashes under the app sandbox. (Session 74.)
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- iCloud container for CloudKit (SwiftData sync) -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.bottsywattsy.FRUS-Explorer</string>
    </array>

    <!-- iCloud services enabled for this container -->
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>

    <!-- iCloud KV store for lightweight cross-device defaults (e.g., active project ID) -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)bottsywattsy.FRUS-Explorer</string>

    <!-- Live Activities: required to start IndexingActivityAttributes Live Activities -->
    <key>com.apple.developer.live-activities</key>
    <true/>

    <!--
        Keychain access group for the NARA Catalog API key.
        Items stored in this group with kSecAttrSynchronizable=true sync via iCloud Keychain
        without requiring any additional entitlement. The $(AppIdentifierPrefix) substitution
        is resolved at build time to <TeamID>. (Session 05 implements the keychain service.)
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)bottsywattsy.FRUS-Explorer</string>
    </array>
</dict>
</plist>
