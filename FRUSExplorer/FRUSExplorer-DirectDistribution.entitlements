<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    FRUS Explorer — Direct Distribution Entitlements (macOS only)
    Used by: macOS target (DirectDistribution config)

    Identical sandbox posture to the App Store configuration by design.
    The Direct Distribution build additionally links Sparkle (configured in target
    build settings). Manual notarization via notarytool is required before release.

    See FRUSExplorer-AppStore.entitlements for notes on keychain sync approach.
-->
<dict>
    <!-- Sandbox: maintained identical to App Store build -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound network: GitHub API, NARA Catalog API, Sparkle update feed -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- iCloud container for CloudKit (SwiftData sync) -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.bottsywattsy.FRUS-Explorer</string>
    </array>

    <!-- iCloud services enabled for this container -->
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>

    <!-- iCloud KV store -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)bottsywattsy.FRUS-Explorer</string>

    <!-- Keychain access group for the NARA Catalog API key -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)bottsywattsy.FRUS-Explorer</string>
    </array>
</dict>
</plist>
